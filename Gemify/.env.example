# Cloud sync (Supabase). Copy to .env and fill in from the Supabase dashboard:
# Project Settings -> API. The anon key is safe to ship — row level security,
# not the key, is what keeps one account's data away from another's.
#
# Run supabase/schema.sql once in the SQL editor before the first sync.
# Metro inlines EXPO_PUBLIC_* at build time, so restart the dev server after
# changing these.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
