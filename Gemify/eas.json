{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "premium-test": {
      "extends": "personal",
      "env": {
        "APP_VARIANT": "personal",
        "EXPO_PUBLIC_PREMIUM_TEST_MODE": "true"
      }
    },
    "production": {
      "env": {
        "EXPO_PUBLIC_PREMIUM_TEST_MODE": "false"
      }
    },
    "personal": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_VARIANT": "personal"
      }
    },
    "demo": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_VARIANT": "demo"
      }
    }
  }
}
